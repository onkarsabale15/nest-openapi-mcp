{
  "name": "@mcp-gen/server",
  "version": "0.0.1",
  "description": "NestJS dynamic module: turns an existing NestJS + @nestjs/swagger app into an MCP server. Placeholder \u2014 Phase 2 of the roadmap (see docs/mcp-generator-hld-lld.md).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onkarsabale15/nest-openapi-mcp.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/onkarsabale15/nest-openapi-mcp#readme",
  "bugs": {
    "url": "https://github.com/onkarsabale15/nest-openapi-mcp/issues"
  },
  "author": "Onkar Sabale",
  "keywords": [
    "nestjs",
    "mcp",
    "model-context-protocol",
    "openapi",
    "swagger",
    "llm-tools",
    "ai-agents"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@mcp-gen/common": "workspace:*",
    "@mcp-gen/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
