{
  "name": "@mcp-gen/server",
  "version": "0.0.1",
  "description": "NestJS dynamic module: turns an existing NestJS + @nestjs/swagger app into an MCP server. Placeholder — Phase 2 of the roadmap (see docs/mcp-generator-hld-lld.md).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@mcp-gen/common": "workspace:*",
    "@mcp-gen/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
