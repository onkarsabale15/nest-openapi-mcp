{
  "name": "@onkarsabale15/mcp-gen-common",
  "version": "0.0.1",
  "description": "Shared types and error classes for mcp-generator packages. No framework dependency.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onkarsabale15/nest-openapi-mcp.git",
    "directory": "packages/common"
  },
  "homepage": "https://github.com/onkarsabale15/nest-openapi-mcp#readme",
  "bugs": {
    "url": "https://github.com/onkarsabale15/nest-openapi-mcp/issues"
  },
  "author": "Onkar Sabale",
  "keywords": [
    "nestjs",
    "mcp",
    "model-context-protocol",
    "openapi",
    "types"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
