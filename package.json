{
  "name": "mcp-generator",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "description": "NestJS + OpenAPI to Model Context Protocol (MCP) server generator — monorepo root",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onkarsabale15/nest-openapi-mcp.git"
  },
  "homepage": "https://github.com/onkarsabale15/nest-openapi-mcp#readme",
  "bugs": {
    "url": "https://github.com/onkarsabale15/nest-openapi-mcp/issues"
  },
  "author": "Onkar Sabale",
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-import-x": "^4.17.1",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  }
}
